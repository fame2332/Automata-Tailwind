import React, { useState, useRef, useEffect } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { Send, X, MessageCircle, Bot, ChevronRight, Loader2 } from 'lucide-react';
import { useTheme } from '../contexts/ThemeContext';

// Define types for chat messages
interface ChatMessage {
  id: string;
  content: string;
  role: 'user' | 'bot';
  timestamp: Date;
}

// Example bot responses based on user queries
const getBotResponse = (query: string): Promise<string> => {
  // Convert query to lowercase for easier matching
  const q = query.toLowerCase();
  
  // Simulate network delay
  return new Promise((resolve) => {
    setTimeout(() => {
      // Automata theory related responses
      if (q.includes('dfa') || q.includes('deterministic finite automaton')) {
        resolve('A Deterministic Finite Automaton (DFA) is a finite state machine that accepts or rejects strings of symbols. In a DFA, for each state and input symbol, there is exactly one transition to a next state. DFAs recognize exactly the regular languages, which are the simplest class in the Chomsky hierarchy.');
      } else if (q.includes('nfa') || q.includes('non-deterministic')) {
        resolve('A Non-deterministic Finite Automaton (NFA) is similar to a DFA but can have multiple possible transitions for a given input symbol from a particular state, or it can have epsilon (empty string) transitions. Despite this added flexibility, NFAs recognize exactly the same languages as DFAs and can always be converted to equivalent DFAs (though this may result in an exponential increase in the number of states).');
      } else if (q.includes('pda') || q.includes('pushdown')) {
        resolve('A Pushdown Automaton (PDA) is a finite automaton that can use a stack to store data. This additional memory makes PDAs more powerful than finite automata, allowing them to recognize context-free languages. PDAs are equivalent in power to context-free grammars. A key example of what PDAs can recognize (that finite automata cannot) is the language of palindromes or the language of matching parentheses.');
      } else if (q.includes('turing')) {
        resolve('A Turing Machine is a mathematical model of computation that defines an abstract machine, which manipulates symbols on a strip of tape according to a table of rules. It has unlimited memory capacity and can simulate any computer algorithm. Turing machines are much more powerful than DFAs or PDAs and can recognize recursively enumerable languages. The Church-Turing thesis posits that any "effectively calculable function" can be computed by a Turing machine.');
      } else if (q.includes('regular expression') || q.includes('regex')) {
        resolve('Regular expressions are patterns used to match character combinations in strings. In automata theory, they precisely define the regular languages, which are recognized by finite automata. A regular expression consists of constants (symbols from the alphabet), operators for union (+), concatenation (juxtaposition), and Kleene star (*) operations. For example, (a+b)* represents all strings consisting of any number of a\'s and b\'s in any order.');
      } else if (q.includes('grammar') || q.includes('cfg') || q.includes('context-free')) {
        resolve('Context-Free Grammar (CFG) is a formal grammar whose production rules can be applied regardless of the context of a nonterminal. They are more powerful than regular languages and can be recognized by pushdown automata. CFGs are commonly used to describe programming languages syntax. The Chomsky Normal Form (CNF) is a simplified form of CFGs where all production rules are of the form A → BC or A → a, making them useful for parsing algorithms like CYK.');
      } else if (q.includes('regular language')) {
        resolve('A regular language is a formal language that can be defined by a regular expression or recognized by a finite automaton. Regular languages are closed under union, intersection, complement, concatenation, and Kleene star operations. Some examples of regular languages include "all strings containing an even number of 0s" or "all strings ending with 01". The pumping lemma for regular languages provides a way to prove that certain languages are not regular.');
      } else if (q.includes('context-free language')) {
        resolve('A context-free language is a language generated by a context-free grammar or recognized by a pushdown automaton. Context-free languages are more powerful than regular languages but less powerful than context-sensitive languages. They can express nested structures like balanced parentheses, which regular languages cannot. The pumping lemma for context-free languages can be used to prove that a language is not context-free.');
      } else if (q.includes('chomsky hierarchy')) {
        resolve('The Chomsky hierarchy is a containment hierarchy of classes of formal grammars that generate formal languages. From most restrictive to least restrictive, it includes: Regular languages (Type 3), Context-free languages (Type 2), Context-sensitive languages (Type 1), and Recursively enumerable languages (Type 0). Each class properly contains the class before it, meaning every regular language is context-free, but not vice versa.');
      } else if (q.includes('pumping lemma')) {
        resolve('The pumping lemma is a property of formal languages that provides a necessary condition for a language to be of a certain type. There are pumping lemmas for regular languages and context-free languages. They are primarily used to prove that certain languages are not regular or not context-free by showing that they violate the necessary condition stated by the relevant pumping lemma.');
      } else if (q.includes('minimize') || q.includes('minimization')) {
        resolve('DFA minimization is the process of transforming a given deterministic finite automaton (DFA) into an equivalent DFA with the minimum number of states. The most common algorithm for DFA minimization is the Hopcroft\'s algorithm, which works by iteratively refining a partition of states according to their behavior. Minimizing a DFA can greatly improve the efficiency of language recognition.');
      } 
      // New advanced automata theory concepts
      else if (q.includes('moore machine') || q.includes('mealy machine')) {
        if (q.includes('moore')) {
          resolve('A Moore machine is a finite-state machine where the outputs depend only on the current state, not on the input. In a Moore machine, each state has an associated output value. This is in contrast to a Mealy machine, where outputs depend on both current state and current input. Moore machines are often preferred in hardware design due to their synchronous nature and predictable output timing.');
        } else {
          resolve('A Mealy machine is a finite-state machine where the output values are determined by both the current state and the current input. This differs from a Moore machine, where outputs depend only on the current state. Mealy machines often require fewer states than equivalent Moore machines, making them more efficient in some scenarios, though they may produce output changes that are asynchronous with the clock in hardware implementations.');
        }
            } else if (q.includes('lindenmayer') || q.includes('l-system')) {        resolve('Lindenmayer systems (L-systems) are parallel rewriting systems introduced by botanist Aristid Lindenmayer to model plant development. They consist of an alphabet of symbols, an initial string (axiom), and production rules that expand each symbol into a larger string. L-systems can generate complex, self-similar patterns like fractals and can be used to model biological structures such as plant growth. They\'re also used in procedural generation for computer graphics.');
      } else if (q.includes('petri net')) {
        resolve('Petri nets are a mathematical modeling language used to describe distributed systems. They consist of places, transitions, and directed arcs connecting places to transitions. Tokens in places represent resources or states, and transitions represent events that can occur. Petri nets are particularly useful for modeling concurrent systems, as they can represent both the system state and the events that change the state. They're used in workflow analysis, manufacturing systems design, and protocol verification.');
      } else if (q.includes('cellular automaton') || q.includes('cellular automata')) {
        resolve('Cellular automata are discrete computational models consisting of a grid of cells, each in one of a finite number of states. The state of each cell evolves over discrete time steps according to fixed rules based on the states of neighboring cells. The most famous cellular automaton is Conway\'s Game of Life, where complex patterns emerge from simple rules. Cellular automata have applications in computational physics, cryptography, and modeling complex systems like biological growth and urban development.');
      } else if (q.includes('chomsky normal form') || q.includes('cnf')) {
        resolve('Chomsky Normal Form (CNF) is a simplified form of context-free grammars where all production rules are of the form A → BC or A → a (where A, B, C are non-terminals and a is a terminal). Any context-free grammar can be transformed into an equivalent grammar in CNF. This standardized form is particularly useful for parsing algorithms like the CYK algorithm, which can determine if a string belongs to a context-free language in O(n³) time, where n is the length of the string.');
      } else if (q.includes('greibach normal form') || q.includes('gnf')) {
        resolve('Greibach Normal Form (GNF) is a normal form for context-free grammars where all production rules are of the form A → aα, where A is a non-terminal, a is a terminal, and α is a (possibly empty) string of non-terminals. Any context-free grammar can be transformed into an equivalent grammar in GNF. This form is particularly useful for proving theoretical results about context-free languages and for implementing certain types of parsers.');
      } else if (q.includes('state complexity') || q.includes('descriptional complexity')) {
        resolve('State complexity (or descriptional complexity) in automata theory refers to the minimum number of states required for a finite automaton to recognize a given language. For DFAs, this represents the size of the minimal DFA for the language. State complexity provides insights into the inherent complexity of formal languages and has implications for the efficiency of algorithms operating on these languages. Operations like union, intersection, and complement can significantly increase state complexity.');
      } else if (q.includes('star height') || q.includes('regular expression complexity')) {
        resolve('Star height is a measure of the complexity of regular expressions, defined as the maximum nesting depth of Kleene star operations. The star-height problem asks whether every regular language can be expressed by a regular expression of a bounded star height. This was a longstanding open problem until it was solved by Hashiguchi in 1988, showing that there exist regular languages with arbitrarily large star height. Star height relates to the structural complexity of regular languages.');
      } else if (q.includes('ambiguity') || q.includes('ambiguous grammar')) {
        resolve('A grammar is ambiguous if there exists at least one string in the language that can be derived in more than one way, resulting in different parse trees. Ambiguity in context-free grammars is undecidable in general, meaning there's no algorithm that can determine if an arbitrary context-free grammar is ambiguous. Ambiguous grammars can cause issues in parsing and compiler design, as the same string might have multiple interpretations. Removing ambiguity often involves rewriting the grammar with precedence rules or using techniques like left-factoring.');
      } else if (q.includes('finite state transducer') || q.includes('fst')) {
        resolve('A Finite State Transducer (FST) is an automaton that maps between two sets of symbols. Unlike finite automata that only accept/reject strings, FSTs generate output strings based on input strings. FSTs can be viewed as finite automata with output, where each transition has both an input and output label. They're widely used in computational linguistics for morphological analysis, phonology, spelling correction, and machine translation, as well as in speech recognition and text processing applications.');
      } else if (q.includes('quantum automata') || q.includes('quantum finite')) {
        resolve('Quantum finite automata are theoretical computational models that combine concepts from quantum computing with classical finite automata. These models use quantum states instead of classical states, allowing them to exist in superpositions and exploit quantum phenomena like interference. Different variants include measure-once, measure-many, and enhanced quantum finite automata. These models are studied to understand the computational power gained by quantum properties and have potential applications in quantum algorithms and protocols.');
      } else if (q.includes('linear bounded automaton') || q.includes('lba')) {
        resolve('A Linear Bounded Automaton (LBA) is a type of Turing machine where the tape is restricted to the initial input length plus some constant amount. LBAs recognize exactly the context-sensitive languages in the Chomsky hierarchy. They are more powerful than pushdown automata but less powerful than unrestricted Turing machines. The computational power of LBAs lies in their ability to reuse space, making them useful theoretical models for algorithms with linear space complexity.');
      } else if (q.includes('parse tree') || q.includes('parsing')) {
        resolve('A parse tree (or derivation tree) is a graphical representation of the syntactic structure of a string according to a formal grammar. Each node in the tree represents a grammar symbol, with the root being the start symbol. Terminal symbols appear as leaf nodes, while non-terminals as internal nodes. Parse trees are fundamental in compiler design, natural language processing, and formal language theory. Various parsing algorithms like LL, LR, LALR, and CYK are used to construct parse trees, each with different characteristics regarding efficiency, grammar class, and implementation complexity.');
      } else if (q.includes('cfl closure') || q.includes('context-free language closure')) {
        resolve('Context-free languages (CFLs) are closed under certain operations but not others. They are closed under union, concatenation, Kleene star, substitution, homomorphism, and inverse homomorphism. However, CFLs are not closed under intersection, complement, or difference. The non-closure under intersection is particularly important: while the intersection of a CFL with a regular language remains a CFL, the intersection of two CFLs may not be context-free. These closure properties have significant implications for parsing and language design.');
      } else if (q.includes('halting problem')) {
        resolve('The Halting Problem asks whether a program, given an input, will eventually terminate or run forever. Alan Turing proved in 1936 that there is no general algorithm to solve the halting problem for all possible program-input pairs. This fundamental result in computability theory demonstrated the existence of undecidable problems and set limits on what computers can achieve. The proof uses a diagonalization argument similar to Cantor\'s proof that the real numbers are uncountable. Many problems in computer science can be shown to be undecidable by reduction to the halting problem.');
      } else if (q.includes('rice theorem')) {
        resolve('Rice\'s Theorem states that all non-trivial semantic properties of programs are undecidable. A property is non-trivial if some programs have it and some don\'t, and it\'s semantic if it depends only on the function computed by the program, not on its specific implementation. This powerful theorem is a generalization of the undecidability of the Halting Problem and shows that we cannot generally determine what a program will do without running it. It has profound implications for program analysis, verification, and optimization.');
      } else if (q.includes('regular pumping') || q.includes('pumping lemma regular')) {
        resolve('The Pumping Lemma for regular languages states that for any regular language L, there exists a pumping length p such that any string s in L with length ≥ p can be divided into three parts s = xyz, such that |y| > 0, |xy| ≤ p, and for all i ≥ 0, xy^iz is in L. This lemma provides a necessary (but not sufficient) condition for a language to be regular. It\'s commonly used as a proof technique to show that certain languages, like a^n b^n, are not regular by demonstrating that they violate the pumping property.');
      } else if (q.includes('cfl pumping') || q.includes('pumping lemma context-free')) {
        resolve('The Pumping Lemma for context-free languages states that for any context-free language L, there exists a pumping length p such that any string s in L with |s| ≥ p can be written as s = uvxyz where |vy| > 0, |vxy| ≤ p, and for all i ≥ 0, uv^ixy^iz is in L. This provides a necessary condition for a language to be context-free. It\'s used to prove languages like a^n b^n c^n are not context-free. While more complex than the regular pumping lemma, it operates on a similar principle of identifying strings that cannot maintain their defining pattern under the required "pumping" operation.');
      } else if (q.includes('myhill-nerode') || q.includes('distinguishable states')) {
        resolve('The Myhill-Nerode theorem provides a necessary and sufficient condition for a language to be regular. It states that a language L is regular if and only if the relation RL (where two strings x and y are equivalent if they have the same future behavior with respect to L) has a finite number of equivalence classes. These equivalence classes correspond exactly to the states in the minimal DFA for L. Unlike the pumping lemma, Myhill-Nerode gives both necessary and sufficient conditions, making it a powerful tool for proving regularity and for constructing minimal DFAs.');
      } else if (q.includes('two-way automata') || q.includes('bidirectional')) {
        resolve('Two-way finite automata can move both left and right on the input tape, unlike standard one-way automata that can only move right. Despite this additional capability, two-way deterministic finite automata (2DFA) recognize exactly the same class of languages as standard DFAs—the regular languages. However, they may require exponentially fewer states for some languages. For nondeterministic cases, two-way NFAs also recognize only regular languages. This equivalence in language recognition power, despite the added movement capability, is a notable result in automata theory.');
      } else if (q.includes('alternating automata') || q.includes('universal states')) {
        resolve('Alternating finite automata (AFA) extend nondeterministic automata by having both existential states (like in NFAs, where at least one path must accept) and universal states (where all paths must accept). Despite this powerful extension, AFAs still recognize only regular languages, though they can be exponentially more succinct than DFAs. Alternation becomes more powerful in other computational models—alternating pushdown automata can recognize EXPTIME languages, and alternating Turing machines characterize complexity classes like P, PSPACE, and EXPTIME when given appropriate resource bounds.');
      } else if (q.includes('np-complete') || q.includes('computational complexity')) {
        resolve('NP-complete problems are the hardest problems in NP (nondeterministic polynomial time), to which all other NP problems can be reduced in polynomial time. A problem is in NP if solutions can be verified in polynomial time. The P vs. NP question asks whether all problems whose solutions can be quickly verified can also be quickly solved. This remains one of the most important open problems in computer science and mathematics. If P = NP, it would revolutionize computation by making many currently intractable problems solvable efficiently. Key NP-complete problems include Boolean satisfiability (SAT), the Traveling Salesman Problem, and graph coloring.');
      } else if (q.includes('time complexity') || q.includes('space complexity')) {
        if (q.includes('time')) {
          resolve('Time complexity measures the amount of time an algorithm takes to complete as a function of input size. It\'s typically expressed using Big O notation, which describes the upper bound of an algorithm\'s growth rate. Common time complexities include O(1) (constant time), O(log n) (logarithmic), O(n) (linear), O(n log n), O(n²) (quadratic), O(2^n) (exponential), and O(n!) (factorial). Efficient algorithms typically have polynomial time complexity or better. Time complexity is a fundamental concept in analyzing algorithm efficiency and feasibility for large inputs.');
        } else {
          resolve('Space complexity measures the amount of memory an algorithm uses as a function of input size. Like time complexity, it\'s typically expressed using Big O notation. Space complexity includes both the auxiliary space used by the algorithm and the input space. Space-efficient algorithms minimize memory usage, which is crucial for large datasets or constrained environments. Trade-offs between time and space complexity are common in algorithm design—sometimes faster algorithms require more memory, while memory-efficient algorithms might run slower. Understanding space complexity helps in selecting appropriate algorithms for specific hardware constraints.');
        }
      }
      // Website usage help
      else if (q.includes('how to use') || q.includes('help')) {
        resolve('To use our Automata Visualizer, select a regular expression from the list, then click on one of the visualization icons (DFA, CFG, or PDA) to view its corresponding visualization. For DFA, you can validate strings by entering them in the text area below and clicking "Validate All". You can also use the step-by-step simulation to see how the automaton processes each input symbol.');
      } else if (q.includes('create') || q.includes('fsm creator')) {
        resolve('You can create your own Finite State Machine by visiting the FSM Creator page. There, you can add states and transitions, set initial and final states, and see a visual representation of your machine as you build it. You can also export your creation as an image or save it for later use.');
      } else if (q.includes('validate') || q.includes('string') || q.includes('test')) {
        resolve('To validate a string against a DFA, first select a regular expression, then click on the DFA icon to view the DFA visualization. Below the visualization, you\'ll find a textarea where you can enter strings (one per line) to validate. Click the "Validate All" button to see which strings are accepted by the DFA. You can also click "Simulate" next to each string to see a step-by-step animation of the validation process.');
      } else if (q.includes('dark mode') || q.includes('light mode') || q.includes('theme')) {
        resolve('You can toggle between dark mode and light mode by clicking the theme toggle button in the top right corner of the screen. Your preference will be saved for future visits.');
      } else if (q.includes('keyboard shortcuts') || q.includes('hotkeys')) {
        resolve('Our application supports several keyboard shortcuts to enhance your productivity: Press "Ctrl+S" to save your current FSM design, "Ctrl+Z" to undo your last action, "Ctrl+Y" to redo, "Del" to delete selected states or transitions, and "Ctrl+Space" to toggle between selection and creation modes in the FSM editor. On macOS, use "Cmd" instead of "Ctrl".');
      } else if (q.includes('export') || q.includes('save') || q.includes('download')) {
        resolve('You can export your automaton in several formats. Click the "Export" button in the visualization view to see options including PNG image, SVG vector graphic, JSON data structure, or LaTeX code. The JSON export can be imported later to continue working on your automaton. You can also save automata to your account if you\'re logged in by clicking "Save to My Collection".');
      } else if (q.includes('convert') || q.includes('transformation')) {
        resolve('Our tool supports various automata transformations. From the DFA view, you can convert to an equivalent minimal DFA by clicking "Minimize DFA". You can also convert between different representations: NFA to DFA, Regular Expression to NFA/DFA, DFA to Regular Expression, and Context-Free Grammar to PDA. Each transformation includes a step-by-step explanation of the conversion algorithm.');
      } else if (q.includes('algorithm') || q.includes('simulation steps')) {
        resolve('In the simulation view, you can observe how automata process input strings step-by-step. Use the "Next" and "Previous" buttons to move through each step, or adjust the "Animation Speed" slider for automatic playback. The current state is highlighted, and the system shows the remaining input and current stack content (for PDAs). We implement standard algorithms including: subset construction for NFA to DFA conversion, Hopcroft\'s algorithm for minimization, and CYK for parsing context-free languages.');
      } else if (q.includes('account') || q.includes('login') || q.includes('register')) {
        resolve('Creating an account allows you to save your automata designs, share them with others, and access them from any device. Click the "Sign In" button in the top-right corner to login or register. We support email-based registration as well as authentication via Google or GitHub accounts. Registered users can also participate in our community forum, sharing examples and helping fellow automata enthusiasts.');
      } else if (q.includes('examples') || q.includes('sample automata')) {
        resolve('We provide several example automata to help you learn. Access them from the "Examples" dropdown menu to explore common patterns like "Strings ending with 01", "Strings with even number of 0s", "Balanced parentheses", and "Palindromes". Each example includes an explanation of the language recognized, its formal definition, and interactive visualizations in multiple formats (DFA/NFA/PDA/CFG as appropriate).');
      } else if (q.includes('report bug') || q.includes('feedback')) {
        resolve('We appreciate your feedback! To report a bug or suggest an improvement, click on the "Feedback" button in the footer or email us at support@automata-visualizer.com. Please include details such as what you were doing when the issue occurred, what you expected to happen, what actually happened, and your browser and operating system information. Screenshots are also very helpful. We review all feedback and continuously improve our tools.');
      }
      // New educational features
      else if (q.includes('quiz me') || q.includes('test my knowledge')) {
        resolve('Here\'s a quick quiz question: What property distinguishes DFAs from NFAs? A) DFAs have a finite number of states while NFAs don\'t B) DFAs have exactly one transition for each state-symbol pair C) DFAs can only recognize regular languages D) DFAs always have fewer states than equivalent NFAs. The correct answer is B - in a DFA, each state has exactly one transition for each input symbol, while NFAs may have multiple transitions or none. Ask me to "explain the answer" if you\'d like more details.');
      } else if (q.includes('explain the answer')) {
        resolve('DFAs (Deterministic Finite Automata) and NFAs (Non-deterministic Finite Automata) have several key differences, but the fundamental distinction is that in a DFA, for each state and input symbol, there is exactly one transition to the next state. In contrast, NFAs may have multiple possible transitions for the same state-symbol pair, or even no transitions (which implicitly leads to rejection). Both DFAs and NFAs recognize exactly the same class of languages (regular languages), and they both have finite states. While DFAs are often easier to implement and use for recognition, NFAs can sometimes represent the same language more concisely with fewer states.');
      } else if (q.includes('course') || q.includes('learn')) {
        resolve('We offer a structured learning path for automata theory through our tutorials section. Start with "Fundamentals of Regular Languages" to understand the basics, then progress to "Finite Automata Design Patterns" and "Advanced Pumping Lemma Proofs". Each tutorial combines theory with interactive exercises using our visualizer. For a more comprehensive education, check our "Resources" page for recommended textbooks, online courses, and video lectures from top universities. Would you like me to suggest specific learning resources for beginners or advanced learners?');
      } else if (q.includes('compare')) {
        if (q.includes('dfa') && q.includes('nfa')) {
          resolve('Comparing DFAs and NFAs: DFAs have exactly one transition per state-symbol pair, while NFAs can have multiple or none. DFAs are typically easier to implement in hardware/software but may require more states. NFAs offer more design flexibility and can be more intuitive for certain problems. Both recognize the exact same class of languages (regular languages). Any NFA can be converted to a DFA using the subset construction algorithm, potentially causing an exponential increase in the number of states. For practical applications, DFAs are often preferred for their deterministic behavior, making them more predictable and easier to debug.');
        } else if ((q.includes('dfa') || q.includes('nfa')) && q.includes('pda')) {
          resolve('Comparing Finite Automata (DFA/NFA) with PDAs: Finite automata (both DFA and NFA) can only recognize regular languages, while PDAs can recognize context-free languages, a strictly larger class. The key difference is that PDAs have a stack for memory, allowing them to handle nested structures like balanced parentheses or palindromes. Finite automata have no memory beyond the current state. PDAs are more powerful computationally but more complex to design and analyze. Every regular language can be recognized by a PDA (by simply ignoring the stack), but many context-free languages cannot be recognized by any finite automaton.');
        } else if (q.includes('pda') && q.includes('turing')) {
          resolve('Comparing PDAs with Turing Machines: PDAs have a stack as memory, while Turing machines have an infinite tape that can be read from and written to. PDAs can recognize context-free languages but cannot recognize many context-sensitive languages. Turing machines can recognize all recursively enumerable languages (including regular, context-free, and context-sensitive). Turing machines are computationally universal, meaning they can simulate any algorithm, while PDAs have significant computational limitations. In the Chomsky hierarchy, PDAs correspond to Type 2 grammars, while Turing machines correspond to Type 0 grammars.');
        } else {
          resolve('I can compare different computational models like DFAs, NFAs, PDAs, and Turing machines in terms of their power, memory capabilities, and the languages they recognize. Please specify which models you\'d like me to compare, for example "compare DFA and NFA" or "compare PDA and Turing machine".');
        }
      }
      // General queries
      else if (q.includes('hello') || q.includes('hi') || q.includes('hey')) {
        resolve('Hello! I\'m your Automata Theory assistant. How can I help you today? You can ask me about automata theory concepts like DFAs, NFAs, PDAs, or how to use our tools. I can explain complex topics, provide examples, compare different computation models, or help you use the visualizer.');
      } else if (q.includes('thank')) {
        resolve('You\'re welcome! If you have any more questions about automata theory or our tools, feel free to ask. I\'m here to help you understand these concepts better. Is there a particular topic you\'d like to explore next?');
      } else if (q.includes('example')) {
        // More specific examples based on the context
        if (q.includes('dfa') || q.includes('nfa')) {
          resolve('Here\'s an example of a DFA that recognizes strings that end with 01: The machine has 3 states: A (start state), B (after seeing 0), and C (accepting state, after seeing 1 following 0). Transitions: From A, on input 0 go to B, on input 1 stay at A. From B, on input 0 stay at B, on input 1 go to C. From C, on input 0 go to B, on input 1 stay at A. State C is the only accepting state. You can visualize this using our DFA tool and test strings like "01" (accepted), "101" (accepted), and "010" (rejected).');
        } else if (q.includes('pda')) {
          resolve('Here\'s an example of a PDA that recognizes the language of balanced parentheses: Start with an empty stack and a single state q. When you see an opening parenthesis "(", push it onto the stack. When you see a closing parenthesis ")", pop from the stack if the top is an opening parenthesis. If the stack is ever empty when trying to pop, or if the stack is not empty at the end, reject the string. Otherwise, accept. This PDA recognizes strings like "()", "(())", and "()(())" but rejects "())(" and "(()".');
        } else if (q.includes('turing')) {
          resolve('Here\'s an example of a Turing Machine that recognizes the language a^nb^nc^n (equal numbers of a\'s, b\'s, and c\'s): The TM works by converting one character at a time from each section. It moves right, changing the first \'a\' to \'X\', then continues right until finding the first \'b\', changes it to \'Y\', then continues to the first \'c\', changes it to \'Z\'. It then returns to the left end and repeats. When all characters are converted, it verifies that the pattern is correct. This demonstrates how TMs can count and compare multiple quantities, something finite automata cannot do.');
        } else {
          resolve('Here\'s an example: Consider the regular language "all strings that end with 01". A DFA for this language would have 3 states: a start state, a state after seeing 0, and an accepting state after seeing 1. You can visualize and test this using our tools! Would you like me to explain how to create this DFA step-by-step using our visualizer?');
        }
      } else if (q.includes('who made') || q.includes('developer') || q.includes('creator')) {
        resolve('This Automata Visualizer was created by a team of computer science students from De La Salle University - Dasmariñas. You can learn more about the team on the "Team" page.');
      } else if (q.includes('reference') || q.includes('book') || q.includes('learn more')) {
        resolve('For learning more about automata theory, I recommend these resources: 1) "Introduction to Automata Theory, Languages, and Computation" by Hopcroft, Motwani, and Ullman - the classic textbook in the field. 2) "Automata Theory, Languages, and Computation" by Linz - very accessible for beginners. 3) Stanford\'s free online course on automata theory. 4) The Automata Tutor website for interactive exercises. Would you like me to provide links to any specific learning resources?');
      } else {
        resolve('I\'m not sure about that. Could you ask something specific about automata theory, finite state machines, or how to use our tools? For example, you can ask about DFAs, NFAs, PDAs, Turing Machines, or how to validate strings against automata. You can also try asking for examples, comparisons between different models, or explanations of specific concepts like the pumping lemma or minimization algorithms.');
      }
    }, Math.random() * 500 + 500); // Random delay between 500-1000ms for more natural feel
  });
};

const ChatBot: React.FC = () => {
  const [isOpen, setIsOpen] = useState(false);
  const [messages, setMessages] = useState<ChatMessage[]>([
    {
      id: '1',
      content: 'Hello! I\'m your Automata Theory assistant. Ask me anything about automata theory, finite state machines, or how to use our tools.',
      role: 'bot',
      timestamp: new Date()
    }
  ]);
  const [inputValue, setInputValue] = useState('');
  const [isTyping, setIsTyping] = useState(false);
  const [hasShownWelcome, setHasShownWelcome] = useState(false);
  const [hasUnreadMessage, setHasUnreadMessage] = useState(false);
  const messagesEndRef = useRef<HTMLDivElement>(null);
  const { theme } = useTheme();

  // Show welcome message after a delay
  useEffect(() => {
    // Show welcome bubble after 3 seconds if user hasn't interacted yet
    const timer = setTimeout(() => {
      if (!hasShownWelcome && !isOpen) {
        setHasShownWelcome(true);
        
        // Flash the chat button with subtle animation
        const bubbleAnimation = document.createElement('div');
        bubbleAnimation.className = 'absolute inset-0 rounded-full bg-white dark:bg-indigo-300 animate-ping opacity-75';
        
        const chatButton = document.querySelector('.chat-button-container');
        if (chatButton) {
          chatButton.appendChild(bubbleAnimation);
          
          // Remove the animation after it plays
          setTimeout(() => {
            if (bubbleAnimation.parentNode === chatButton) {
              chatButton.removeChild(bubbleAnimation);
            }
          }, 2000);
        }
      }
    }, 3000);
    
    return () => clearTimeout(timer);
  }, [hasShownWelcome, isOpen]);

  // Reset unread message indicator when chat is opened
  useEffect(() => {
    if (isOpen) {
      setHasUnreadMessage(false);
    }
  }, [isOpen]);
  
  // Mark messages as unread when new bot messages arrive while chat is closed
  useEffect(() => {
    if (!isOpen && messages.length > 1) {
      const lastMessage = messages[messages.length - 1];
      if (lastMessage.role === 'bot') {
        setHasUnreadMessage(true);
      }
    }
  }, [messages, isOpen]);

  // Scroll to bottom when new messages are added
  const scrollToBottom = () => {
    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  };

  useEffect(() => {
    if (isOpen) {
      scrollToBottom();
    }
  }, [messages, isOpen]);

  // Handle user message submission
  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    
    if (!inputValue.trim()) return;
    
    // Add user message
    const userMessage: ChatMessage = {
      id: Date.now().toString(),
      content: inputValue,
      role: 'user',
      timestamp: new Date()
    };
    
    setMessages(prev => [...prev, userMessage]);
    setInputValue('');
    
    // Show typing indicator
    setIsTyping(true);
    
    try {
      // Get bot response
      const botResponse = await getBotResponse(inputValue);
      
      // Add bot response
      const botMessage: ChatMessage = {
        id: (Date.now() + 1).toString(),
        content: botResponse,
        role: 'bot',
        timestamp: new Date()
      };
      
      setMessages(prev => [...prev, botMessage]);
    } catch (error) {
      // Handle error
      const errorMessage: ChatMessage = {
        id: (Date.now() + 1).toString(),
        content: 'Sorry, I encountered an error processing your request.',
        role: 'bot',
        timestamp: new Date()
      };
      
      setMessages(prev => [...prev, errorMessage]);
    } finally {
      setIsTyping(false);
    }
  };

  // Format time for message timestamp
  const formatTime = (date: Date) => {
    return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  };

  return (
    <div className="fixed bottom-6 right-6 z-50">
      <AnimatePresence>
        {isOpen && (
          <motion.div
            initial={{ opacity: 0, y: 20, scale: 0.8 }}
            animate={{ opacity: 1, y: 0, scale: 1 }}
            exit={{ opacity: 0, y: 20, scale: 0.8 }}
            transition={{
              type: 'spring',
              stiffness: 400,
              damping: 30
            }}
            className={`w-80 sm:w-96 h-[30rem] flex flex-col rounded-2xl shadow-xl overflow-hidden ${
              theme === 'dark' 
                ? 'bg-gray-800 border border-gray-700' 
                : 'bg-white border border-gray-200'
            }`}
          >
            {/* Chatbot Header */}
            <div className={`p-4 flex justify-between items-center ${
              theme === 'dark' ? 'bg-gray-900' : 'bg-gradient-to-r from-indigo-600 to-purple-600'
            }`}>
              <div className="flex items-center space-x-2">
                <Bot className="h-6 w-6 text-white" />
                <h3 className="text-lg font-semibold text-white">Automata Assistant</h3>
              </div>
              <button 
                onClick={() => setIsOpen(false)} 
                className="text-white hover:text-gray-200 transition-colors"
              >
                <X className="h-5 w-5" />
              </button>
            </div>
            
            {/* Messages Container */}
            <div className={`flex-1 overflow-y-auto p-4 ${theme === 'dark' ? 'bg-gray-800' : 'bg-gray-50'}`}>
              {messages.map(message => (
                <motion.div
                  key={message.id}
                  initial={{ opacity: 0, y: 10 }}
                  animate={{ opacity: 1, y: 0 }}
                  transition={{ duration: 0.3 }}
                  className={`mb-4 flex ${message.role === 'user' ? 'justify-end' : 'justify-start'}`}
                >
                  <div className={`max-w-[80%] rounded-2xl px-4 py-2 ${
                    message.role === 'user' 
                      ? theme === 'dark' 
                        ? 'bg-indigo-600 text-white' 
                        : 'bg-indigo-500 text-white' 
                      : theme === 'dark' 
                        ? 'bg-gray-700 text-gray-100' 
                        : 'bg-white text-gray-800 border border-gray-200'
                  }`}>
                    <p className="text-sm break-words">{message.content}</p>
                    <div className={`text-xs mt-1 ${
                      message.role === 'user' 
                        ? theme === 'dark' ? 'text-indigo-200' : 'text-indigo-100' 
                        : theme === 'dark' ? 'text-gray-400' : 'text-gray-500'
                    }`}>
                      {formatTime(message.timestamp)}
                    </div>
                  </div>
                </motion.div>
              ))}
              
              {/* Typing indicator */}
              {isTyping && (
                <motion.div
                  initial={{ opacity: 0, y: 10 }}
                  animate={{ opacity: 1, y: 0 }}
                  className="flex justify-start mb-4"
                >
                  <div className={`rounded-2xl px-4 py-2 ${
                    theme === 'dark' ? 'bg-gray-700 text-gray-100' : 'bg-white text-gray-800 border border-gray-200'
                  }`}>
                    <div className="flex items-center space-x-2">
                      <div className="w-2 h-2 rounded-full bg-gray-400 animate-bounce" 
                           style={{ animationDelay: '0ms' }}></div>
                      <div className="w-2 h-2 rounded-full bg-gray-400 animate-bounce" 
                           style={{ animationDelay: '150ms' }}></div>
                      <div className="w-2 h-2 rounded-full bg-gray-400 animate-bounce" 
                           style={{ animationDelay: '300ms' }}></div>
                    </div>
                  </div>
                </motion.div>
              )}
              
              <div ref={messagesEndRef} />
            </div>
            
            {/* Input Area */}
            <form 
              onSubmit={handleSubmit}
              className={`p-3 border-t ${theme === 'dark' ? 'border-gray-700 bg-gray-800' : 'border-gray-200 bg-white'}`}
            >
              <div className="flex space-x-2">
                <input
                  type="text"
                  value={inputValue}
                  onChange={e => setInputValue(e.target.value)}
                  placeholder="Ask something about automata theory..."
                  className={`flex-1 py-2 px-3 rounded-full focus:outline-none ${
                    theme === 'dark' 
                      ? 'bg-gray-700 text-white border border-gray-600 focus:border-indigo-500' 
                      : 'bg-gray-100 text-gray-800 border border-gray-300 focus:border-indigo-400'
                  }`}
                />
                <button 
                  type="submit"
                  disabled={!inputValue.trim() || isTyping}
                  className={`p-2 rounded-full transition-colors ${
                    inputValue.trim() && !isTyping
                      ? theme === 'dark'
                        ? 'bg-indigo-600 hover:bg-indigo-700 text-white'
                        : 'bg-indigo-500 hover:bg-indigo-600 text-white'
                      : theme === 'dark'
                        ? 'bg-gray-700 text-gray-400'
                        : 'bg-gray-200 text-gray-400'
                  }`}
                >
                  {isTyping ? 
                    <Loader2 className="h-5 w-5 animate-spin" /> : 
                    <Send className="h-5 w-5" />
                  }
                </button>
              </div>
            </form>
          </motion.div>
        )}
      </AnimatePresence>
      
      {/* Toggle Button */}
      <motion.button
        onClick={() => setIsOpen(!isOpen)}
        whileHover={{ scale: 1.05 }}
        whileTap={{ scale: 0.95 }}
        className={`
          ${isOpen ? 'hidden' : 'flex'} 
          chat-button-container
          relative
          items-center justify-center 
          h-14 w-14 rounded-full shadow-lg 
          ${theme === 'dark' ? 'bg-indigo-600' : 'bg-gradient-to-r from-indigo-600 to-purple-600'}
          text-white
        `}
      >
        {hasUnreadMessage && (
          <span className="absolute top-0 right-0 h-3 w-3 rounded-full bg-red-500 animate-pulse"></span>
        )}
        <motion.div
          animate={{ rotate: isOpen ? 180 : 0 }}
          transition={{ duration: 0.2 }}
        >
          <MessageCircle className="h-6 w-6" />
        </motion.div>
      </motion.button>
    </div>
  );
};

export default ChatBot; 